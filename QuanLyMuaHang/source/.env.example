# ==============================================================================
# Database & Cache (MySQL & Redis)
# ==============================================================================
# 1. Khi dùng Laragon (Khuyến nghị trên Windows: Rất nhẹ máy, tiết kiệm 2GB RAM):
#    SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quanlymuahang?useUnicode=true&characterEncoding=utf8
#    SPRING_DATASOURCE_USERNAME=app   (hoặc root)
#    DB_PASSWORD=your_password        (hoặc để trống nếu user root Laragon không đặt pass)
#    REDIS_HOST=localhost
#    REDIS_PORT=6379
#    REDIS_PASSWORD=                  (để trống vì Laragon Redis mặc định không cần pass)
#
# 2. Khi dùng Docker Compose:
#    SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/quanlymuahang?useUnicode=true&characterEncoding=utf8
#    SPRING_DATASOURCE_USERNAME=app
#    DB_PASSWORD=replace_with_a_unique_random_app_password
#    MYSQL_ROOT_PASSWORD=replace_with_a_unique_random_root_password
#    REDIS_HOST=localhost
#    REDIS_PORT=6380
#    REDIS_PASSWORD=replace_with_a_unique_random_redis_password
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/quanlymuahang?useUnicode=true&characterEncoding=utf8
SPRING_DATASOURCE_USERNAME=app
DB_PASSWORD=replace_with_a_unique_random_app_password
MYSQL_ROOT_PASSWORD=replace_with_a_unique_random_root_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
APP_TIMEZONE=Asia/Ho_Chi_Minh
SERVER_PORT=8080
APP_FRONTEND_URL=http://localhost:5173
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Quan tri vien
SESSION_COOKIE_SECURE=false
APP_PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
FILE_STORAGE_ROOT=./data/files

# ==============================================================================
# Cấu hình Mail & SMTP (Quên mật khẩu & Gửi mail đặt lại mật khẩu)
# ==============================================================================
# Ví dụ khi dùng Gmail:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-email@gmail.com
#   MAIL_PASSWORD=your-app-password (Mật khẩu ứng dụng 16 ký tự do Google cấp)
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#   MAIL_FROM=your-email@gmail.com
#
# Ở môi trường dev cục bộ (chưa có SMTP thật):
# Có thể để trống MAIL_USERNAME/MAIL_PASSWORD, hệ thống sẽ in trực tiếp đường link
# đặt lại mật khẩu ra màn hình log console ([DEV RESET LINK]) để bạn test dễ dàng.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=noreply@khvt.local
MAIL_FROM_NAME=Quản lý mua hàng KHVT
APP_RESET_PASSWORD_URL=http://localhost:5173/reset-password
RESET_TOKEN_VALIDITY_MINUTES=15
