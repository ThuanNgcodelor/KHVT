spring.flyway.enabled=true
# Optional self-hosted Word editor. Never reuse the application login JWT secret.
cfc.word-editor.enabled=${WORD_EDITOR_ENABLED:false}
cfc.word-editor.document-server-url=${WORD_EDITOR_DOCUMENT_SERVER_URL:}
cfc.word-editor.backend-url=${WORD_EDITOR_BACKEND_URL:}
cfc.word-editor.jwt-secret=${WORD_EDITOR_JWT_SECRET:}
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=${FLYWAY_BASELINE_ON_MIGRATE:false}
spring.flyway.baseline-version=0
spring.flyway.baseline-description=Legacy BookingBase schema before Flyway
spring.flyway.validate-on-migrate=${FLYWAY_VALIDATE_ON_MIGRATE:false}
spring.flyway.clean-disabled=true
spring.flyway.out-of-order=false

# Legacy tables still use ddl-auto=update. This filter prevents Hibernate from
# creating/updating/dropping/truncating Flyway-owned hr_* objects.
spring.jpa.properties.hibernate.hbm2ddl.schema_filter_provider=com.booking.system.config.LegacySchemaFilterProvider

# HR import staging contains PII. Payload is kept only for the configured
# post-confirm/rollback audit window, then purged by the UTC scheduler.
app.hr.import.payload-retention-days=${HR_IMPORT_PAYLOAD_RETENTION_DAYS:30}
app.hr.import.payload-purge-cron=${HR_IMPORT_PAYLOAD_PURGE_CRON:0 30 2 * * *}

# Production attendance rollout: enable first with shadow mode, then turn shadow off after HR sign-off.
app.hr.attendance.production.enabled=${HR_PRODUCTION_ATTENDANCE_ENABLED:true}
app.hr.attendance.production.shadow-mode=${HR_PRODUCTION_ATTENDANCE_SHADOW_MODE:true}

# Multipart Upload Settings for OCR and Document attachments
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=100MB

cfc.telegram.bot-token=${TELEGRAM_BOT_TOKEN:}
cfc.telegram.webhook-secret=${TELEGRAM_WEBHOOK_SECRET:}
